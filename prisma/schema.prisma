generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  receptionist
  doctor
  lab_tech
  pharmacist
  admin
}

enum ReferralStatus {
  pending
  paid
}

enum Gender {
  male
  female
  other
}

enum VisitType {
  consultation
  injection
  family_planning
  direct_lab
}

enum VisitStatus {
  waiting
  consultation_paid
  with_doctor
  lab
  pharmacy
  billing
  done
  archived
}

enum FeeStatus {
  paid
  pending
  waived
}

enum PaymentMethod {
  cash
  mpesa
  insurance
  credit
  other
}

enum LabStatus {
  pending
  in_progress
  ready
}

enum RestockStatus {
  pending
  approved
  rejected
}

enum RestockDepartment {
  pharmacy
  lab
}

enum PrescriptionStatus {
  pending
  dispensed
  issued
  returned
  cancelled
}

enum PrescriptionItemStatus {
  pending
  issued
  declined
  returned
  restocked
  cancelled
}

enum ChargeCategory {
  consultation
  procedure
  lab
  medication
  family_planning
}

enum PharmacyTxType {
  sale
  refund
  adjustment
}

enum LabUrgency {
  routine
  urgent
  stat
}

enum OrderStatus {
  pending
  fulfilled
  cancelled
}

enum ProductCategory {
  medication  
  consumable  
  general
}
enum MovementReason {
  sale           
  dispense       
  issue           
  restock        
  return_to_stock 
  adjustment     
  writeoff        
}

enum OrderDepartment {
  doctor
  lab
  reception
  admin
}

// ─── Staff ────────────────────────────────────────────────────────────────────

model Staff {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  role       Role
  password   String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  visits_as_doctor      Visit[]           @relation("DoctorVisits")
  lab_requests_handled  LabRequest[]      @relation("LabTechRequests")
  prescriptions_handled Prescription[]    @relation("PharmacistPrescriptions")
  payments_collected    Payment[]         @relation("CashierPayments")
  sessions              Session[]
  clinic_expenses       ClinicExpense[]
  pharmacy_expenses     PharmacyExpense[]
  otc_sales             OtcSale[]         @relation("OtcSoldBy")
  audit_logs            AuditLog[]
  customer_payments    CustomerPayment[] 

  orders_requested PharmacyOrder[] @relation("OrderRequestedBy")
  orders_fulfilled PharmacyOrder[] @relation("OrderFulfilledBy")
  stock_movements  StockMovement[]

  @@map("staff")
}

// ─── Session ──────────────────────────────────────────────────────────────────

model Session {
  id         Int      @id @default(autoincrement())
  staff_id   Int
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  staff Staff @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("sessions")
}

// ─── Patient ──────────────────────────────────────────────────────────────────

model Patient {
  id          Int      @id @default(autoincrement())
  name        String
  age         Int
  gender      Gender
  phone       String?
  national_id String?  @unique
  blood_group String?
  allergies   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  visits Visit[]

  @@index([name])
  @@index([phone])
  @@map("patients")
}

// ─── Visit ────────────────────────────────────────────────────────────────────

model Visit {
  id           Int         @id @default(autoincrement())
  patient_id   Int
  doctor_id    Int?
  queue_number Int?
  visit_type   VisitType   @default(direct_lab)
  status       VisitStatus @default(waiting)

  chief_complaint String?

  subjective String?
  objective  String?
  assessment String?
  plan       String?

  diagnosis      String?
  diagnosis_code String?

  notes String?

  procedure_name    String?
  procedure_type    String?
  procedure_notes   String?
  procedure_done_by String?

  referred_by    String?
  referrer_phone String?
  referral       Referral?

  has_lab_results         Boolean @default(false)
  medication_verification Boolean @default(false)

  arrived_at DateTime @default(now())
  updated_at DateTime @updatedAt

  patient       Patient        @relation(fields: [patient_id], references: [id])
  doctor        Staff?         @relation("DoctorVisits", fields: [doctor_id], references: [id])
  vitals        Vitals?
  lab_requests  LabRequest[]
  prescriptions Prescription[]
  bill          Bill?

  @@index([status, arrived_at])
  @@index([patient_id, arrived_at])
  @@index([doctor_id])
  @@map("visits")
}

// ─── Vitals ───────────────────────────────────────────────────────────────────

model Vitals {
  id               Int      @id @default(autoincrement())
  visit_id         Int      @unique
  weight_kg        Float?
  height_cm        Float?
  bp_systolic      Int?
  bp_diastolic     Int?
  temperature      Float?
  pulse            Int?
  spo2             Int?
  respiratory_rate Int?
  vitals_notes     String?
  recorded_at      DateTime @default(now())

  visit Visit @relation(fields: [visit_id], references: [id], onDelete: Cascade)

  @@map("vitals")
}

// ─── Lab ──────────────────────────────────────────────────────────────────────

model LabRequest {
  id           Int        @id @default(autoincrement())
  visit_id     Int
  tech_id      Int?
  urgency      LabUrgency @default(routine)
  ordered_by   String?
  status       LabStatus  @default(pending)
  notes        String?
  requested_at DateTime   @default(now())
  completed_at DateTime?
  updated_at   DateTime   @updatedAt

  visit Visit            @relation(fields: [visit_id], references: [id], onDelete: Cascade)
  tech  Staff?           @relation("LabTechRequests", fields: [tech_id], references: [id])
  items LabRequestItem[]

  @@index([visit_id])
  @@index([status, requested_at])
  @@map("lab_requests")
}

model LabRequestItem {
  id              Int       @id @default(autoincrement())
  lab_request_id  Int
  catalog_id      Int?
  test_name       String
  category        String?
  reference_range String?
  unit_cost       Int       @default(0)
  result          String?
  result_data     Json?
  result_notes    String?
  flagged         Boolean   @default(false)
  status          LabStatus @default(pending)
  completed_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  lab_request LabRequest      @relation(fields: [lab_request_id], references: [id], onDelete: Cascade)
  catalog     LabTestCatalog? @relation(fields: [catalog_id], references: [id], onDelete: SetNull)

  stock_usages LabStockUsage[]

  @@index([lab_request_id])
  @@index([catalog_id])
  @@map("lab_request_items")
}

model LabTestCatalog {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  category        String?
  reference_range String?
  unit_cost       Int     @default(0)
  is_active       Boolean @default(true)
  result_template Json?

  items LabRequestItem[]

  @@map("lab_test_catalog")
}

model LabStock {
  id            Int       @id @default(autoincrement())
  name          String
  category      String?
  current_stock Int       @default(0)
  reorder_level Int       @default(0)
  unit          String    @default("units")
  unit_cost     Int       @default(0)
  supplier      String?
  batch_number  String?
  expiry_date   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  usages           LabStockUsage[]
  restock_requests RestockRequest[]

  @@map("lab_stock")
}

model LabStockUsage {
  id                  Int      @id @default(autoincrement())
  lab_request_item_id Int
  stock_item_id       Int?
  item_name           String
  quantity            Int
  quantity_deducted   Int      @default(0)
  unit                String?
  unit_cost           Int      @default(0)
  recorded_by         Int?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  lab_request_item LabRequestItem @relation(fields: [lab_request_item_id], references: [id], onDelete: Cascade)
  stock_item       LabStock?      @relation(fields: [stock_item_id], references: [id], onDelete: SetNull)

  @@unique([lab_request_item_id, stock_item_id])
  @@index([stock_item_id])
  @@map("lab_stock_usage")
}

// ─── Prescription ─────────────────────────────────────────────────────────────

model Prescription {
  id            Int                @id @default(autoincrement())
  visit_id      Int
  pharmacist_id Int?
  prescribed_by String?
  status        PrescriptionStatus @default(pending)
  notes         String?
  verified_by   String?
  verified_at   DateTime?
  verify_notes  String?
  returned_by   String?
  returned_at   DateTime?
  return_reason String?
  cancelled_by  String?
  cancelled_at  DateTime?
  cancel_reason String?

  dispensed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  visit      Visit              @relation(fields: [visit_id], references: [id], onDelete: Cascade)
  pharmacist Staff?             @relation("PharmacistPrescriptions", fields: [pharmacist_id], references: [id])
  items      PrescriptionItem[]

  @@index([visit_id])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              Int     @id @default(autoincrement())
  prescription_id Int
  drug_name       String  
  dosage          String
  frequency       String
  duration        String
  quantity        Int     @default(1)
  unit_cost       Int     @default(0)
  form            String?
  return_reason   String?
  product_id Int?

  status         PrescriptionItemStatus @default(pending)
  decline_reason String?
  dispensed_at   DateTime?

  product      Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull)
  prescription Prescription @relation(fields: [prescription_id], references: [id], onDelete: Cascade)

  @@index([prescription_id])
  @@index([product_id])
  @@map("prescription_items")
}


model PharmacyOrder {
  id              Int             @id @default(autoincrement())
  department      OrderDepartment
  requested_by    String 
  requested_by_id Int?
  status          OrderStatus     @default(pending)
  fulfilled_by    String?
  fulfilled_by_id Int?
  fulfilled_at    DateTime?
  cancelled_by    String?
  cancelled_at    DateTime?
  cancel_reason   String?
  notes           String?
  requested_at    DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  requester Staff? @relation("OrderRequestedBy", fields: [requested_by_id], references: [id], onDelete: SetNull)
  fulfiller Staff? @relation("OrderFulfilledBy", fields: [fulfilled_by_id], references: [id], onDelete: SetNull)

  items PharmacyOrderItem[]

  @@index([status, requested_at])
  @@index([department, status])
  @@map("pharmacy_orders")
}

model PharmacyOrderItem {
  id       Int     @id @default(autoincrement())
  order_id Int
  name     String  
  quantity Int     @default(1)
  notes    String?

  product_id    Int?
  fulfilled_qty Int  @default(0)

  order   PharmacyOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([product_id])
  @@map("pharmacy_order_items")
}

// ─── Product ──────────────────────────────────────────────────

model Product {
  id   Int     @id @default(autoincrement())
  sku  String? @unique
  name String  @unique

  category ProductCategory @default(medication)
  sub_category String?

  unit      String  @default("piece")
  is_active Boolean @default(true) 
  generic_name String?
  form         String?
  strength     String?

  current_stock Int @default(0)
  reorder_level Int @default(50)
  supplier String?
  normal_price      Int @default(0)
  promotional_price Int @default(0)
  wholesale_price   Int @default(0)

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  otc_sale_items     OtcSaleItem[]
  prescription_items PrescriptionItem[]
  order_items        PharmacyOrderItem[]
  restock_requests   RestockRequest[]
  movements          StockMovement[]
  batches ProductBatch[]

  @@index([category, is_active])
  @@index([category, name])
  @@index([category, sub_category])
  @@index([name])
  @@map("products")
}

model ProductBatch {
  id Int  @id @default(autoincrement())
  product_id    Int
  batch_number  Int @default(autoincrement()) @unique
  expiry_date   DateTime?
  quantity  Int    @default(0)  
  received_at   DateTime  @default(now())
  received_by   String?   
  notes         String?
  is_exhausted  Boolean   @default(false) 

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, batch_number])
  @@index([product_id, expiry_date])   
  @@index([product_id, is_exhausted])
  @@map("product_batches")
}

model StockMovement {
  id            Int   @id @default(autoincrement())
  product_id    Int
  delta         Int 
  reason        MovementReason
  ref_type      String? 
  ref_id        Int?
  balance_after Int
  note          String?
  staff_id      Int?
  created_at    DateTime       @default(now())

  product Product @relation(fields: [product_id], references: [id])
  staff   Staff?  @relation(fields: [staff_id], references: [id], onDelete: SetNull)

  @@index([product_id, created_at])
  @@index([reason, created_at])
  @@index([ref_type, ref_id])
  @@map("stock_movements")
}

// ─── OTC sales ────────────────────────────────────────────────────────────────

model OtcSale {
  id             Int           @id @default(autoincrement())
  receipt_number String        @unique
  customer_name  String        @default("Walk-in Customer")
  payment_method PaymentMethod @default(cash)
  sold_by_id     Int?
  subtotal       Int           @default(0) 
  tax_total      Int           @default(0)
  total          Int           @default(0)
  sold_at        DateTime      @default(now())
  customer_id   Int?
  discount_amount Int       @default(0)
  discount_reason String?
  discount_by     String?


  customer      PharmacyCustomer? @relation(fields: [customer_id], references: [id])
  sold_by_staff Staff?        @relation("OtcSoldBy", fields: [sold_by_id], references: [id])
  items         OtcSaleItem[]
  payments      OtcSalePayment[]

  @@index([sold_at])
  @@map("otc_sales")
}

model OtcSaleItem {
  id         Int    @id @default(autoincrement())
  sale_id    Int
  product_id Int? 
  name       String
  quantity   Int    @default(1)
  unit_price Int    @default(0) // tax-inclusive, what was charged
  unit_cost  Int    @default(0) // NEW — snapshot, keeps margin reconstructable
  tax_amount Int    @default(0) // NEW — tax contained in this line, in total
  price_tier String @default("normal")

  sale    OtcSale  @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([sale_id])
  @@index([product_id])
  @@map("otc_sale_items")
}
model PharmacyCustomer {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String?  @unique
  created_at DateTime @default(now())

  sales     OtcSale[]
  payments  CustomerPayment[]

  @@map("pharmacy_customers")
}


model OtcSalePayment {
  id         Int           @id @default(autoincrement())
  sale_id    Int
  method     PaymentMethod
  amount     Int
  reference  String?
  created_at DateTime      @default(now())

  sale OtcSale @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@index([sale_id])
  @@map("otc_sale_payments")
}


model CustomerPayment {
  id          Int      @id @default(autoincrement())
  customer_id Int
  amount      Int      // positive = paying down debt
  method      String   // cash, mpesa, etc.
  reference   String?
  staff_id    Int?
  created_at  DateTime @default(now())

  customer PharmacyCustomer @relation(fields: [customer_id], references: [id])
  staff    Staff?           @relation(fields: [staff_id], references: [id])

  @@index([customer_id, created_at])
  @@map("customer_payments")
}

// ─── Settings / audit / notifications ─────────────────────────────────────────

model ClinicSettings {
  id      Int @id @default(autoincrement())
  name    String?
  tagline String?
  address String?
  phone   String?
  email   String?

  pharmacy_settings Json?
  security          Json?

  updated_at DateTime @updatedAt

  @@map("clinic_settings")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  staff_id    Int?
  user        String?
  action      String
  description String
  category    String
  entity      String?
  entity_id   Int?
  ip_address  String?
  timestamp   DateTime @default(now())

  staff Staff? @relation(fields: [staff_id], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([timestamp])
  @@index([entity, entity_id])
  @@index([staff_id])
  @@map("audit_log")
}

model Notification {
  id              Int      @id @default(autoincrement())
  staff_id        Int?
  type            String
  title           String
  message         String
  is_read         Boolean  @default(false)
  visit_id        Int?
  target_role     Json?
  target_staff_id Int?
  timestamp       DateTime @default(now())

  @@index([target_staff_id, is_read])
  @@map("notifications")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Bill {
  id       Int @id @default(autoincrement())
  visit_id Int @unique

  consultation_fee                Int       @default(0)
  consultation_fee_status         FeeStatus @default(pending)
  consultation_fee_status_paid_at DateTime?
  consultation_fee_waived_by      String?
  consultation_fee_waive_reason   String?
  consultation_fee_waived_at      DateTime?

  lab_fee        Int       @default(0)
  medication_fee Int       @default(0)
  procedure_fee  Int       @default(0)
  stage2_status  FeeStatus @default(pending)
  stage2_paid_at DateTime?

  discount_amount Int     @default(0)
  discount_reason String?

  total_amount Int       @default(0)
  fee_status   FeeStatus @default(pending)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  visit    Visit     @relation(fields: [visit_id], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([fee_status])
  @@map("bills")
}

model Payment {
  id         Int           @id @default(autoincrement())
  bill_id    Int
  cashier_id Int?
  amount     Int
  method     PaymentMethod @default(cash)
  reference  String?
  stage      Int
  paid_at    DateTime      @default(now())

  bill    Bill   @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  cashier Staff? @relation("CashierPayments", fields: [cashier_id], references: [id])

  @@index([bill_id])
  @@index([paid_at])
  @@map("payments")
}

model ChargeTemplate {
  id         Int            @id @default(autoincrement())
  name       String         @unique
  category   ChargeCategory
  amount     Int
  is_active  Boolean        @default(true)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  @@map("charge_templates")
}

// ─── Pharmacy financials ──────────────────────────────────────────────────────

model PharmacyTransaction {
  id          Int            @id @default(autoincrement())
  type        PharmacyTxType
  description String
  amount      Int
  created_by  Int?
  created_at  DateTime       @default(now())

  @@map("pharmacy_transactions")
}

model PharmacyExpense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Int
  category    String?
  recorded_by Int?
  incurred_at DateTime @default(now())
  created_at  DateTime @default(now())

  recorded_by_staff Staff? @relation(fields: [recorded_by], references: [id])

  @@map("pharmacy_expenses")
}

model ClinicExpense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Int
  category    String?
  recorded_by Int?
  incurred_at DateTime @default(now())
  created_at  DateTime @default(now())

  recorded_by_staff Staff? @relation(fields: [recorded_by], references: [id])

  @@map("clinic_expenses")
}


model RestockRequest {
  id           Int               @id @default(autoincrement())
  department   RestockDepartment
  product_id   Int? // RENAMED from drug_stock_id
  lab_stock_id Int?

  quantity  Int 

  batch_number String?
  expiry_date  DateTime?

  notes              String?
  status             RestockStatus @default(pending)
  requested_by       String
  requested_by_id    Int?
  verified_by        String?
  verified_at        DateTime?
  verification_notes String?
  requested_at       DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  product   Product?  @relation(fields: [product_id], references: [id])
  lab_stock LabStock? @relation(fields: [lab_stock_id], references: [id])

  @@index([status, department])
  @@index([product_id, status])
  @@map("restock_requests")
}

// ─── External referrals ───────────────────────────────────────────────────────

model Referral {
  id                Int            @id @default(autoincrement())
  visit_id          Int            @unique
  referrer_name     String
  referrer_facility String?
  referrer_phone    String?
  commission_amount Int?
  status            ReferralStatus @default(pending)
  notes             String?
  paid_at           DateTime?
  paid_by           String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  visit Visit @relation(fields: [visit_id], references: [id])

  @@map("external_referrals")
}