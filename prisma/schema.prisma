generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  receptionist
  doctor
  lab_tech
  pharmacist
  admin
}

enum ReferralStatus {
  pending
  paid
}

enum Gender {
  male
  female
  other
}

enum VisitType {
  consultation
  injection
  family_planning
  direct_lab
}

enum VisitStatus {
  waiting
  consultation_paid
  with_doctor
  lab
  pharmacy
  billing
  done
  archived
}

enum FeeStatus {
  paid
  pending
  waived
}

enum PaymentMethod {
  cash
  mpesa
  insurance
  other
}

enum LabStatus {
  pending
  in_progress
  ready
}

enum RestockStatus {
  pending
  approved
  rejected
}

enum RestockDepartment {
  pharmacy
  lab
}


enum PrescriptionStatus {
  pending     
  dispensed  
  issued     
  returned   
  cancelled 
}

enum PrescriptionItemStatus {
  pending
  issued
  declined
  returned
  restocked
  cancelled
}

enum ChargeCategory {
  consultation
  procedure
  lab
  medication
  family_planning
}

enum PharmacyTxType {
  sale
  refund
  adjustment
}

// ADDED: urgency level for lab orders
enum LabUrgency {
  routine
  urgent
  stat
}

// ADDED: pharmacy supply order status
enum OrderStatus {
  pending
  fulfilled
  cancelled
}

// ─── Staff ────────────────────────────────────────────────────────────────────

model Staff {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  role       Role
  password   String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  visits_as_doctor Visit[] @relation("DoctorVisits")
  lab_requests_handled  LabRequest[] @relation("LabTechRequests")
  prescriptions_handled Prescription[]  @relation("PharmacistPrescriptions")
  payments_collected  Payment[] @relation("CashierPayments")
  sessions Session[]
  clinic_expenses  ClinicExpense[]
  pharmacy_expenses PharmacyExpense[]
  otc_sales  OtcSale[]  @relation("OtcSoldBy")
  audit_logs  AuditLog[]

  @@map("staff")
}

// ─── Session ──────────────────────────────────────────────────────────────────

model Session {
  id         Int      @id @default(autoincrement())
  staff_id   Int
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  staff Staff @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── Patient ──────────────────────────────────────────────────────────────────

model Patient {
  id            Int       @id @default(autoincrement())
  name          String
  age Int
  gender        Gender
  phone         String?
  national_id   String?   @unique
  blood_group   String?
  allergies     String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  visits Visit[]

  @@map("patients")
}

// ─── Visit ────────────────────────────────────────────────────────────────────

model Visit {
  id             Int         @id @default(autoincrement())
  patient_id     Int
  doctor_id      Int?
  queue_number   Int?
  visit_type     VisitType   @default(direct_lab)
  status         VisitStatus @default(waiting)

  // ADDED: receptionist captures chief complaint at registration
  chief_complaint String?

  // ADDED: SOAP note fields — stored directly on Visit for simplicity
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?

  // Diagnosis
  diagnosis      String?
  // ADDED: ICD code for the diagnosis
  diagnosis_code String?

  notes          String?

  // Procedure / service performed during consultation (complete-procedure)
  procedure_name    String?
  procedure_type    String? // 'procedure' | 'family_planning'
  procedure_notes   String?
  procedure_done_by String?

  // Direct lab only
  referred_by    String?
  referrer_phone String?
  referral Referral?
  has_lab_results        Boolean @default(false)
  medication_verification Boolean @default(false)

  arrived_at DateTime @default(now())
  updated_at DateTime @updatedAt

  patient       Patient        @relation(fields: [patient_id], references: [id])
  doctor        Staff?         @relation("DoctorVisits", fields: [doctor_id], references: [id])
  vitals        Vitals?
  lab_requests  LabRequest[]
  prescriptions Prescription[]
  bill          Bill?

  @@map("visits")
}

// ─── Vitals ───────────────────────────────────────────────────────────────────

model Vitals {
  id              Int      @id @default(autoincrement())
  visit_id        Int      @unique
  weight_kg       Float?
  height_cm       Float?
  bp_systolic     Int?
  bp_diastolic    Int?
  temperature     Float?
  pulse           Int?
  spo2            Int?
  // ADDED: respiratory rate and free-text notes on vitals
  respiratory_rate Int?
  vitals_notes    String?
  recorded_at     DateTime @default(now())

  visit Visit @relation(fields: [visit_id], references: [id], onDelete: Cascade)

  @@map("vitals")
}

model LabRequest {
  id           Int        @id @default(autoincrement())
  visit_id     Int
  tech_id      Int?
  urgency      LabUrgency @default(routine)
  ordered_by   String?
  status       LabStatus  @default(pending)
  notes        String?
  requested_at DateTime   @default(now())
  completed_at DateTime?
  updated_at   DateTime   @updatedAt
  visit Visit  @relation(fields: [visit_id], references: [id], onDelete: Cascade)
  tech  Staff? @relation("LabTechRequests", fields: [tech_id], references: [id])
  items LabRequestItem[]

  @@map("lab_requests")
}

model LabRequestItem {
  id              Int       @id @default(autoincrement())
  lab_request_id  Int
  catalog_id      Int?      // FK to LabTestCatalog
  test_name       String    // denormalised for display even if catalog entry is deleted
  category        String?
  reference_range String?
  unit_cost       Int       @default(0)
  result          String?
  result_data     Json?
  result_notes    String?
  flagged         Boolean   @default(false)
  status          LabStatus @default(pending)
  completed_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  lab_request     LabRequest      @relation(fields: [lab_request_id], references: [id], onDelete: Cascade)
  catalog         LabTestCatalog? @relation(fields: [catalog_id], references: [id], onDelete: SetNull)

  @@map("lab_request_items")
}

model LabTestCatalog {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  category        String?
  reference_range String?
  unit_cost       Int              @default(0)
  is_active       Boolean          @default(true)
  result_template Json?

  items           LabRequestItem[]

  @@map("lab_test_catalog")
}

model LabStock {
  id            Int       @id @default(autoincrement())
  name          String
  category      String?   // hematology | chemistry | urinalysis | supplies | microbiology
  current_stock Int       @default(0)
  reorder_level Int       @default(0)
  unit          String    @default("units")
  unit_cost     Int       @default(0)
  supplier      String?
  batch_number  String?
  expiry_date   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("lab_stock")
}

// ─── Prescription ─────────────────────────────────────────────────────────────

model Prescription {
  id            Int                @id @default(autoincrement())
  visit_id      Int
  pharmacist_id Int?
  prescribed_by String?
  status        PrescriptionStatus @default(pending)
  notes         String?
  verified_by   String?
  verified_at   DateTime?
  verify_notes  String?
  // ADDED: return fields when doctor sends prescription back to pharmacy
  returned_by   String?
  returned_at   DateTime?
  return_reason String?
  cancelled_by   String?
  cancelled_at   DateTime?
  cancel_reason  String?

  dispensed_at  DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  visit      Visit   @relation(fields: [visit_id], references: [id], onDelete: Cascade)
  pharmacist Staff?   @relation("PharmacistPrescriptions", fields: [pharmacist_id], references: [id])
  items      PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id              Int                    @id @default(autoincrement())
  prescription_id Int
  drug_name       String
  dosage          String
  frequency       String
  duration        String
  quantity        Int                    @default(1)
  unit_cost       Int                    @default(0)
  // 'oral' | 'injection' — set by the doctor's prescription modal
  form            String?
  // Reason the doctor returned an issued item (distinct from decline_reason)
  return_reason   String?
  // FK to DrugStock — what lets confirm-restock increment the exact drug
  drug_id         Int?
  status          PrescriptionItemStatus @default(pending)
  // Reason used when the pharmacist declines an individual item
  decline_reason  String?
  dispensed_at    DateTime?

  drug         DrugStock?   @relation(fields: [drug_id], references: [id], onDelete: SetNull)
  prescription Prescription @relation(fields: [prescription_id], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}


model PharmacyOrder {
  id           Int         @id @default(autoincrement())
  department   String      // 'doctor' | 'lab' | other departments
  requested_by String      // staff name
  status       OrderStatus @default(pending)
  fulfilled_by String?     // pharmacist name
  fulfilled_at DateTime?
  requested_at DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  items PharmacyOrderItem[]

  @@map("pharmacy_orders")
}

model PharmacyOrderItem {
  id       Int    @id @default(autoincrement())
  order_id Int
  name     String
  quantity Int    @default(1)
  notes    String?

  order PharmacyOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("pharmacy_order_items")
}

model DrugStock {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  generic_name  String    @default("")
  category      String?   // antibiotic | analgesic | antihypertensive | etc.
  form          String?   // tablet | capsule | syrup | injection | etc.
  strength      String?   // e.g. "500mg", "250mg/5ml"
  current_stock Int       @default(0)
  unit          String    @default("tablets")
  reorder_level Int       @default(50)
  expiry_date   DateTime?
  // StockTab's expandable row reads supplier + batch_number
  supplier      String?
  batch_number  String?
  unit_cost     Int       @default(0)   // pharmacy's buying/cost price

  // 3 OTC sale tiers — these ARE the markup system (no separate 4th
  // "clinic price" column; that's computed, not stored)
  normal_price      Int @default(0)
  promotional_price Int @default(0)
  wholesale_price   Int @default(0)

  updated_at    DateTime  @updatedAt

  otc_sale_items     OtcSaleItem[]
  prescription_items PrescriptionItem[]

  @@map("drug_stock")
}

model OtcSale {
  id             Int           @id @default(autoincrement())
  receipt_number String        @unique // e.g. "OTC-00231"
  customer_name  String        @default("Walk-in Customer")
  payment_method PaymentMethod @default(cash)
  sold_by_id     Int?
  total          Int           @default(0)
  sold_at        DateTime      @default(now())

  sold_by_staff Staff?        @relation("OtcSoldBy", fields: [sold_by_id], references: [id])
  items         OtcSaleItem[]

  @@map("otc_sales")
}

model OtcSaleItem {
  id         Int    @id @default(autoincrement())
  sale_id    Int
  drug_id    Int?
  name       String 
  quantity   Int    @default(1)
  unit_price Int    @default(0)
  price_tier String @default("normal") // normal | promotional | wholesale

  sale OtcSale    @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  drug DrugStock? @relation(fields: [drug_id], references: [id], onDelete: SetNull)

  @@map("otc_sale_items")
}

model ClinicSettings {
  id                      Int      @id @default(autoincrement())
  prescription_markup_pct Int      @default(25) // e.g. 25 = 25% markup

  // Clinic profile (ClinicProfileTab)
  name    String?
  tagline String?
  address String?
  phone   String?
  email   String?

  // Admin-editable config slices (JSON)
  visit_rules       Json? 
  lab_settings      Json?
  pharmacy_settings Json? 
  notifications     Json? 
  security          Json? 

  updated_at DateTime @updatedAt

  @@map("clinic_settings")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  staff_id    Int?     
  user        String? 
  action      String  
  description String   
  category    String   
  entity      String?  
  entity_id   Int? 
  ip_address  String?
  timestamp   DateTime @default(now())

  staff Staff? @relation(fields: [staff_id], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([timestamp])
  @@map("audit_log")
}

model Notification {
  id       Int      @id @default(autoincrement())
  staff_id Int?     
  type     String   
  title    String
  message  String
  is_read  Boolean @default(false)
  visit_id  Int?
  target_role Json?
  target_staff_id Int?
  timestamp DateTime @default(now())

  @@map("notifications")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Bill {
  id       Int @id @default(autoincrement())
  visit_id Int @unique

  consultation_fee            Int       @default(0)
  consultation_fee_status     FeeStatus @default(pending)
  consultation_fee_status_paid_at DateTime?

  lab_fee        Int       @default(0)
  medication_fee Int       @default(0)
  procedure_fee  Int       @default(0)
  stage2_status  FeeStatus @default(pending)
  stage2_paid_at DateTime?

  total_amount Int       @default(0)
  fee_status   FeeStatus @default(pending)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  visit    Visit     @relation(fields: [visit_id], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("bills")
}

model Payment {
  id         Int           @id @default(autoincrement())
  bill_id    Int
  cashier_id Int?
  amount     Int
  method     PaymentMethod @default(cash)
  reference  String?
  stage      Int
  paid_at    DateTime      @default(now())

  bill    Bill   @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  cashier Staff? @relation("CashierPayments", fields: [cashier_id], references: [id])

  @@map("payments")
}


model ChargeTemplate {
  id         Int            @id @default(autoincrement())
  name       String         @unique
  category   ChargeCategory
  amount     Int
  is_active  Boolean        @default(true)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  @@map("charge_templates")
}

// ─── Pharmacy Financials ──────────────────────────────────────────────────────

model PharmacyTransaction {
  id          Int            @id @default(autoincrement())
  type        PharmacyTxType
  description String
  amount      Int
  created_by  Int?
  created_at  DateTime       @default(now())

  @@map("pharmacy_transactions")
}

model PharmacyExpense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Int
  category    String?
  recorded_by Int?
  incurred_at DateTime @default(now())
  created_at  DateTime @default(now())
  recorded_by_staff Staff? @relation(fields: [recorded_by], references: [id])

  @@map("pharmacy_expenses")
}

// ─── Clinic Expenses ─────────────────────────────────────────────────────────

model ClinicExpense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Int
  category    String?
  recorded_by Int?
  incurred_at DateTime @default(now())
  created_at  DateTime @default(now())

  recorded_by_staff Staff? @relation(fields: [recorded_by], references: [id])

  @@map("clinic_expenses")
}


model RestockRequest {
  id                 Int               @id @default(autoincrement())
  department         RestockDepartment
  item_id            Int               // FK to DrugStock or LabStock depending on department
  item_name          String            // denormalised for display
  current_stock      Int               @default(0)
  requested_qty      Int
  received_qty       Int               @default(0)
  unit_cost          Int               @default(0)
  supplier           String?
  batch_number       String?
  expiry_date        DateTime?
  notes              String?
  direct_restock     Boolean           @default(false) // true = no verification needed
  status             RestockStatus     @default(pending)
  requested_by       String            // staff username
  verified_by        String?
  verified_at        DateTime?
  verification_notes String?
  requested_at       DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  @@map("restock_requests")
}

model Referral {
  id                 Int      @id @default(autoincrement())
  visit_id           Int      @unique   // one referral per visit
  referrer_name      String             // Dr. Mwenda
  referrer_facility  String             // Kenyatta Hospital
  referrer_phone     String?
  test_ordered       String             // what test they sent the patient for
  test_cost          Int                // actual cost charged to patient
  commission_rate    Float  @default(0.1)  // 0.1 = 10%
  commission_amount  Int                // test_cost × commission_rate (stored, not computed)
  status             ReferralStatus @default(pending)
  notes              String?
  referred_at        DateTime @default(now())
  paid_at            DateTime?
  paid_by            String?            // admin's name who recorded the payment
  amount_paid        Int?               // actual amount paid (may differ from commission_amount)

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  visit Visit @relation(fields: [visit_id], references: [id])

  @@map("external_referrals")
}